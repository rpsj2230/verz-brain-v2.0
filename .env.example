# Every variable the application reads, with what it is for.
# Copy to .env for local work. .env is gitignored and must stay that way.
# Task ids: M0.4.3

# --- identity of this deployment ------------------------------------------
# development | staging | production. Production turns off the interactive API
# docs, because the schema names every tool and capability in the system.
BRAIN_ENV=development

# Set by the pipeline from the git SHA. Shown on /health/ready and the status
# page, so "what is actually running" is answerable without guessing.
BRAIN_COMMIT_SHA=unknown

# --- data -----------------------------------------------------------------
# A bare postgresql:// is accepted and pointed at psycopg 3 automatically.
DATABASE_URL=postgresql://brain:change-me@localhost:5432/brain

# Optional here. Absent means the cache is skipped, not that the app fails.
VALKEY_URL=redis://localhost:6379/0

# Set at deploy time. Used once, by the first migration, to give the
# application role a password. Never the same as the postgres superuser.
APP_ROLE_PASSWORD=

# --- behaviour ------------------------------------------------------------
# Migrations run during startup under an advisory lock, before readiness
# passes. Set false only if you apply them by hand with `alembic upgrade head`.
BRAIN_RUN_MIGRATIONS=true

# The console and the widget only. Empty means no cross-origin access at all,
# which is the safe default; there is no wildcard in any environment.
BRAIN_CORS_ORIGINS=

# Distinct from the model timeout. This bounds the whole request.
BRAIN_REQUEST_TIMEOUT_SECONDS=30

# --- profile --------------------------------------------------------------
# lite | standard | full. Which set of wave-2 components this install runs;
# see src/brain/ops/wiring.py for the memory each one costs.
#
#   lite      the application, pooler, database and cache. Nothing else.
#             Records to the audit ledger and ships no traces. This is what
#             is deployed today.
#   standard  adds the worker, the object store and the PII analyser.
#   full      adds the trace ledger, which needs about 2.3 GiB more and does
#             not fit on the current host. See docs/needs-rupash.md item 25.
#
# Defaults to lite when unset, deliberately: forgetting this variable should
# leave an install under-featured, not running a trace stack nobody sized.
BRAIN_PROFILE=lite

# Where spans go. Leave empty on a lite install: startup refuses a trace
# destination on a profile that runs no trace ledger, because the client
# library would otherwise post spans at a host that either drops them
# silently or belongs to somebody else and keeps them.
BRAIN_LANGFUSE_HOST=
BRAIN_LANGFUSE_PUBLIC_KEY=
BRAIN_LANGFUSE_SECRET_KEY=

# --- deploy (used by ops/deploy.sh, not by the app) -----------------------
DEPLOY_HOST=verz-vps
DEPLOY_UUID=c74hlhygvg7scjttu8ydwnqi
DEPLOY_URL=https://brain.194.233.66.89.sslip.io
