#!/bin/sh
# Runs the same gates CI runs, before anything leaves the laptop.
#
# This is not a substitute for server-side branch protection — a hook can be skipped with
# --no-verify, and on a private repo without GitHub Pro there is no server-side rule to
# fall back on. It is here so the common case (someone pushes broken work by accident)
# is caught in seconds rather than in a CI queue.
#
# Install: git config core.hooksPath ops/hooks
# Task ids: M0.1.3, M38.1.3

set -e

# Git hooks inherit the environment of whatever shell git was invoked from, which on
# Windows is often not the one where uv was added to PATH. Resolve it explicitly rather
# than assuming, or the hook fails for a reason that has nothing to do with the code.
if command -v uv >/dev/null 2>&1; then
  UV=uv
else
  for candidate in \
    "$LOCALAPPDATA/Microsoft/WinGet/Links/uv.exe" \
    "$LOCALAPPDATA/Microsoft/WinGet/Packages/astral-sh.uv_Microsoft.Winget.Source_8wekyb3d8bbwe/uv.exe" \
    "$HOME/.local/bin/uv" \
    "$HOME/.cargo/bin/uv"
  do
    if [ -x "$candidate" ]; then UV="$candidate"; break; fi
  done
fi

if [ -z "$UV" ]; then
  echo "pre-push: cannot find uv." >&2
  echo "  Install it, or push with --no-verify and rely on CI." >&2
  exit 1
fi

echo "pre-push: format"
"$UV" run ruff format --check src tests

echo "pre-push: lint"
"$UV" run ruff check src tests

echo "pre-push: types (strict)"
"$UV" run mypy

echo "pre-push: invariants"
# These encode rules that must never break. If one fails, the push stops here.
"$UV" run pytest tests/invariants -q

echo "pre-push: sweeps"
"$UV" run python -m brain.ops.sweeps tool_registry
"$UV" run python -m brain.ops.sweeps traceability

echo "pre-push: all gates green"
